{% comment %}
  RMA image hero starter. Upload media to Shopify and select it below.
  This is a section, not a complete theme. No guessed collection URLs or autoplay.
{% endcomment %}
{% liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign heading_tag = section.settings.heading_tag
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
%}
<section id="rma-hero-{{ section.id }}" class="rma-editorial" aria-labelledby="rma-title-{{ section.id }}">
  {% if hero_image != blank %}
    <picture class="rma-editorial__image">
      {% if mobile_image != blank %}
        <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 360 }} 360w, {{ mobile_image | image_url: width: 480 }} 480w, {{ mobile_image | image_url: width: 640 }} 640w" sizes="100vw" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
      {% endif %}
      {{ hero_image | image_url: width: 1600 | image_tag: widths: '640, 960, 1280, 1600', sizes: '100vw', loading: image_loading, fetchpriority: image_priority, alt: section.settings.image_alt }}
    </picture>
  {% endif %}
  <div class="rma-editorial__copy">
    <{{ heading_tag }} id="rma-title-{{ section.id }}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    {% if section.settings.link != blank and section.settings.label != blank %}<a class="rma-editorial__button" href="{{ section.settings.link }}">{{ section.settings.label | escape }}</a>{% endif %}
  </div>
</section>
<style>
#rma-hero-{{ section.id }}{position:relative;isolation:isolate;min-height:480px;background:#10181e;color:#f6f2e9;display:grid;align-items:center}
#rma-hero-{{ section.id }} .rma-editorial__image{position:absolute;inset:0;z-index:-2}
#rma-hero-{{ section.id }} .rma-editorial__image img{width:100%;height:100%;object-fit:cover}
#rma-hero-{{ section.id }}::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(8,16,22,.78),rgba(8,16,22,.15))}
#rma-hero-{{ section.id }} .rma-editorial__copy{max-width:760px;padding:clamp(28px,6vw,96px)}
#rma-hero-{{ section.id }} :is(h1,h2){font-family:Georgia,serif;font-weight:400;line-height:1.07;letter-spacing:-.025em;font-size:clamp(36px,5.5vw,80px);margin:0 0 22px}
#rma-hero-{{ section.id }} p{font:inherit;line-height:1.6;max-width:46ch;margin:0 0 28px}
#rma-hero-{{ section.id }} .rma-editorial__button{display:inline-flex;align-items:center;min-height:44px;padding:12px 24px;border-radius:4px;background:#c7ad74;color:#10181e;text-decoration:none;font-weight:600}
#rma-hero-{{ section.id }} a:focus-visible{outline:3px solid #fff;outline-offset:4px}
@media(max-width:749px){#rma-hero-{{ section.id }}{min-height:640px;align-items:end}#rma-hero-{{ section.id }}::after{background:linear-gradient(0deg,rgba(8,16,22,.85),rgba(8,16,22,.08))}}
</style>
{% schema %}
{"name":"RMA editorial hero","tag":"section","class":"rma-editorial-section","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile portrait image"},{"type":"text","id":"image_alt","label":"Image description","default":"Warm lifestyle showroom with travel, home and technology accessories."},{"type":"text","id":"heading","label":"Heading","default":"A world of finds."},{"type":"select","id":"heading_tag","label":"Heading level","options":[{"value":"h1","label":"H1 — main page heading"},{"value":"h2","label":"H2 — section heading"}],"default":"h2"},{"type":"text","id":"text","label":"Supporting text","default":"One place to explore."},{"type":"text","id":"label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"link","label":"Button destination"}],"presets":[{"name":"RMA editorial hero"}]}
{% endschema %}
